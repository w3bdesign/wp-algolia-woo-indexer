"Please contact your hosting provider."

msgid "Algolia connection not checked"
msgstr "Algolia connection not checked"

msgid "Save your Application ID, Search API Key, Write API Key, and index name to check the connection automatically when this page opens."
msgstr "Save your Application ID, Search API Key, Write API Key, and index name to check the connection automatically when this page opens."

msgid "Not connected to Algolia"
msgstr "Not connected to Algolia"

msgid "The connection check failed. Check your Application ID, Search API Key, index name, and server connectivity, then reload this page."
msgstr "The connection check failed. Check your Application ID, Search API Key, index name, and server connectivity, then reload this page."

msgid "The Application ID must contain only letters and numbers. Correct it, save the settings, and reload this page."
msgstr "The Application ID must contain only letters and numbers. Correct it, save the settings, and reload this page."

msgid "Your server could not reach Algolia within the connection check. Check DNS, HTTPS access, and firewall settings, then reload this page."
msgstr "Your server could not reach Algolia within the connection check. Check DNS, HTTPS access, and firewall settings, then reload this page."

msgid "Connected to Algolia"
msgstr "Connected to Algolia"

msgid "A test search succeeded using your Search API Key. The connection and search access to the configured index are working. No product records were returned or changed. The separate Write API Key is verified when products are uploaded."
msgstr "A test search succeeded using your Search API Key. The connection and search access to the configured index are working. No product records were returned or changed. The separate Write API Key is verified when products are uploaded."

msgid "Algolia rejected the Search API Key or search access. Use the Search API Key from the same Algolia application and check that it can search the configured index. See the diagnostic below for any additional key restrictions."
msgstr "Algolia rejected the Search API Key or search access. Use the Search API Key from the same Algolia application and check that it can search the configured index. See the diagnostic below for any additional key restrictions."

msgid "Algolia connection not verified"
msgstr "Algolia connection not verified"

msgid "Algolia responded, but the configured index was not found. Check the index name. If the index is new, send products to create it, then reload this page."
msgstr "Algolia responded, but the configured index was not found. Check the index name. If the index is new, send products to create it, then reload this page."

msgid "Algolia rate-limited the connection check. Wait a moment, then reload this page to try again."
msgstr "Algolia rate-limited the connection check. Wait a moment, then reload this page to try again."

#. translators: 1: WordPress HTTP error code, 2: Transport error message.
#, php-format
msgid "Transport error (%1$s): %2$s"
msgstr "Transport error (%1$s): %2$s"

msgid "The response did not include an Algolia error message."
msgstr "The response did not include an Algolia error message."

msgid "The response was not valid JSON. A proxy, firewall, or upstream service may have returned it instead of Algolia."
msgstr "The response was not valid JSON. A proxy, firewall, or upstream service may have returned it instead of Algolia."

msgid "Algolia returned an unexpected search response, so index access could not be verified."
msgstr "Algolia returned an unexpected search response, so index access could not be verified."

#. translators: 1: HTTP response code, 2: HTTP reason phrase, 3: API error or response diagnostic.
#, php-format
msgid "HTTP %1$d (%2$s): %3$s"
msgstr "HTTP %1$d (%2$s): %3$s"

msgid "Algolia rejected the connection-check request as invalid. See the diagnostic below for the exact reason. Check the saved Application ID and index name."
msgstr "Algolia rejected the connection-check request as invalid. See the diagnostic below for the exact reason. Check the saved Application ID and index name."

msgid "Algolia or an upstream service returned a server error. See the diagnostic below and try again shortly."
msgstr "Algolia or an upstream service returned a server error. See the diagnostic below and try again shortly."

msgid "Diagnostic details:"
msgstr "Diagnostic details:"

#: classes/class-algolia-woo-indexer.php
msgid "Search API Key"
msgstr "Search API Key"

msgid "Copy the Search API Key from Algolia. It is used only to check the connection, not to upload products. It must be able to search the configured index."
msgstr "Copy the Search API Key from Algolia. It is used only to check the connection, not to upload products. It must be able to search the configured index."

#. Plugin Name of the plugin/theme
msgid "Algolia Woocommerce Indexer"
msgstr "Algolia Woocommerce Indexer"

#. Description of the plugin/theme
msgid "Implement Algolia indexing from Woocommerce"
msgstr "Implement Algolia indexing from Woocommerce"
