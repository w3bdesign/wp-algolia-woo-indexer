{
  "name": "daniel/algolia-woo-indexer",
  "type": "wordpress-plugin",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "w3bdesign",
      "email": "45217974+w3bd3sign@users.noreply.github.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "algolia/algoliasearch-client-php": "^4.55"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpcompatibility/phpcs-compatinfo": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.5.0"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "*",
    "wp-coding-standards/wpcs": "*",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^13.4",
    "brain/monkey": "^2.7",
    "mockery/mockery": "^1.6",
    "phpmd/phpmd": "^3.0",
    "phpstan/phpstan": "^2.3",
    "phpstan/extension-installer": "^1.4",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-stubs/woocommerce-stubs": "^11.3"
  },
  "autoload-dev": {
    "psr-4": {
      "Algowoo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-text --coverage-clover=build/coverage/clover.xml",
    "phpcs": "phpcs .",
    "phpcbf": "phpcbf .",
    "phpmd": "phpmd analyze classes tests algolia-woo-indexer.php uninstall.php --ruleset phpmd.xml --no-progress",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G"
  }
}
