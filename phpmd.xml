<?xml version="1.0"?>
<ruleset name="algolia-woo-indexer"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>
		PHPMD rules for the plugin and its tests. Rules that conflict with the
		WordPress coding standards enforced by phpcs.xml are excluded.
		Pre-existing findings in plugin code are recorded in phpmd.baseline.xml.
	</description>

	<!-- WordPress favours descriptive snake_case names such as $algolia_application_id. -->
	<rule ref="rulesets/naming.xml">
		<exclude name="LongVariable" />
	</rule>

	<rule ref="rulesets/cleancode.xml" />
	<rule ref="rulesets/codesize.xml" />
	<rule ref="rulesets/design.xml" />
	<rule ref="rulesets/unusedcode.xml" />

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/fixtures/*</exclude-pattern>
</ruleset>
